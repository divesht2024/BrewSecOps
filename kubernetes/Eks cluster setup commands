(a) Create EKS Cluster (without node group)

eksctl create cluster \
  --name=brewsecureops-cluster \
  --region=us-east-1 \
  --zones=us-east-1a,us-east-1b \
  --version=1.36 \
  --without-nodegroup


---

(b) Associate IAM OIDC Provider

eksctl utils associate-iam-oidc-provider \
  --region us-east-1 \
  --cluster brewsecureops-cluster \
  --approve

c. node group

eksctl create nodegroup \
  --cluster=brewsecureops-cluster \
  --region=us-east-1 \
  --name=brewsecureops-nodes \
  --node-type=t3.micro \
  --nodes=1 \
  --nodes-min=1 \
  --nodes-max=2 \
  --node-volume-size=20 \
  --ssh-access \
  --ssh-public-key=starbucks \
  --managed \
  --asg-access \
  --external-dns-access \
  --full-ecr-access
